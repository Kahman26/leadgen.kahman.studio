@echo off
chcp 65001 >nul
rem Сбор карточек Яндекс Карт браузером (Playwright + Google Chrome).
rem Окно Chrome откроется видимым. Капчу, если появится, решает человек —
rem сбор подождёт и продолжит. Прервали — запустите снова, продолжит с места.
rem Результат — файл в папке yandex\, его грузят в leadgen: меню →
rem «Импорт с Яндекс Карт».
cd /d "%~dp0"
set Q=
set /p Q=Что искать на Яндекс Картах [бани и сауны]: 
if "%Q%"=="" set Q=бани и сауны
python yandex_collect.py "%Q%" --radius 30
pause
