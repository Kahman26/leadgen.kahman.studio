# Кто может входить. Логин и пароль через двоеточие, пользователи
# через точку с запятой. Файл должен быть закрыт: chmod 600
LEADGEN_USERS=andrey:придумайте-пароль;marketolog:другой-пароль

# Пароль можно хранить хэшем вместо открытого текста:
#   python auth.py hash мой-пароль
# LEADGEN_USERS=andrey:pbkdf2$200000$соль$хэш

# Кто видит отчёт о рабочем времени сотрудников. Логины через запятую.
# Если не задать — только arkprhrv.
LEADGEN_ADMINS=arkprhrv

# Часовой пояс города в часах от UTC: по нему считаются рабочие дни.
# Екатеринбург — 5.
LEADGEN_TZ_OFFSET=5

# Токен Dadata (бесплатно до 10 000 запросов в сутки)
# Получить: https://dadata.ru/profile/#info
DADATA_TOKEN=
# Секретный ключ нужен только API стандартизации, сейчас не используется
DADATA_SECRET=

# Необязательно: ключ PageSpeed Insights
PAGESPEED_KEY=

# Где слушать веб-интерфейс
LEADGEN_HOST=127.0.0.1
LEADGEN_PORT=8765
